generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizations OrganizationMember[]
  projects      Project[]
  chats         Chat[]
  memories      Memory[]
  apiKeys       ApiKey[]
  executions    Execution[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  type           ProjectType   @default(WEB_APP)
  status         ProjectStatus @default(ACTIVE)
  userId         String
  organizationId String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  chats        Chat[]
  files        File[]
  deployments  Deployment[]
  executions   Execution[]
}

model Chat {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  userId    String
  projectId String?
  model     String   @default("gpt-4o")
  provider  String   @default("openai")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  messages Message[]

  // Sidebar lists a user's chats newest-first (listChats).
  @@index([userId, updatedAt])
}

model Message {
  id          String      @id @default(cuid())
  chatId      String
  role        MessageRole
  content     String      @db.Text
  toolCalls   Json?
  toolResults Json?
  metadata    Json?
  tokens      Int?
  cost        Float?
  createdAt   DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Opening a chat loads its messages in order (getChatWithMessages); the
  // save path also deletes by chatId.
  @@index([chatId, createdAt])
}

model Agent {
  id          String      @id @default(cuid())
  name        String
  type        AgentType
  description String?
  config      Json?
  status      AgentStatus @default(IDLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  executions Execution[]
  tasks      Task[]
}

model Task {
  id          String     @id @default(cuid())
  agentId     String?
  executionId String?
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Int        @default(0)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  agent     Agent?     @relation(fields: [agentId], references: [id])
  execution Execution? @relation(fields: [executionId], references: [id])
}

model Execution {
  id        String          @id @default(cuid())
  agentId   String?
  userId    String
  projectId String?
  status    ExecutionStatus @default(RUNNING)
  input     Json?
  output    Json?
  logs      Json?
  tokens    Int?
  cost      Float?
  startedAt DateTime        @default(now())
  endedAt   DateTime?

  agent   Agent?   @relation(fields: [agentId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  tasks   Task[]
}

model Memory {
  id        String     @id @default(cuid())
  userId    String
  type      MemoryType
  key       String
  value     Json
  metadata  Json?
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  name      String
  path      String
  content   String?  @db.Text
  mimeType  String?
  size      Int?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Deployment {
  id         String           @id @default(cuid())
  projectId  String
  provider   String
  url        String?
  status     DeploymentStatus @default(PENDING)
  config     Json?
  logs       String?          @db.Text
  deployedAt DateTime?
  createdAt  DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  provider  String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectType {
  WEB_APP
  MOBILE_APP
  API
  GAME
  SAAS
  ECOMMERCE
  DASHBOARD
  RESEARCH
  AUTOMATION
  OTHER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentType {
  ORCHESTRATOR
  RESEARCH
  CODING
  APP_BUILDER
  GAME_DEV
  UI_UX
  DEPLOYMENT
  FILE_ANALYSIS
  MEMORY
}

enum AgentStatus {
  IDLE
  RUNNING
  ERROR
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MemoryType {
  SESSION
  LONG_TERM
  ENTITY
  PREFERENCE
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

/// Technology-tagged preflight rules: the basics each stack needs to run, plus
/// common break-classes. Seeded in code (src/lib/deploy/preflight.ts) and GROWN
/// at deploy time by web research — `source` distinguishes curated vs researched.
model PreflightRule {
  id        String   @id @default(cuid())
  tech      String   // stack tag: "dotnet", "flask", "spring", "node", ...
  ruleId    String   // stable id, unique within a tech
  title     String
  detail    String   @db.Text
  source    String   @default("web") // "seed" | "web"
  sourceUrl String?
  // Optional deterministic fix distilled from the advisory; auto-applied ONLY when
  // verified=true (promoted after a real success track record in FixOutcome).
  verified   Boolean @default(false)
  fixGlob    String?
  fixFind    String? @db.Text
  fixReplace String? @db.Text
  fixFlags   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tech, ruleId])
  @@index([tech])
}

/// Outcome ledger for the self-improving deploy engine: every fix/rule the engine
/// applies, and whether the deploy+verification that followed SUCCEEDED. Aggregated
/// into per-rule success rates so future selection prefers what has worked and
/// demotes what hasn't (outcome-weighted / contextual-bandit-style learning).
model FixOutcome {
  id             String   @id @default(cuid())
  tech           String   // stack tag
  ruleId         String   // preflight rule or fix identifier this outcome is about
  errorSignature String?  // normalized error this addressed (for matching)
  action         String   // what was done (rule id / transform / "ai-fix")
  success        Boolean  // did the subsequent deploy/verify pass?
  phase          String   @default("deploy") // "build" | "deploy" | "health" | "smoke"
  details        String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([tech, ruleId])
  @@index([tech, success])
}
